/dts-v1/;
#include "cv180x_base_riscv.dtsi"
#include "cv180x_asic_qfn.dtsi"
#include "cv180x_asic_sd.dtsi"
#include "cv180x_default_memmap.dtsi"

/ {
	model = "Milk-V Duo";
};

&mipi_rx{
	snsr-reset = <&portc 8 GPIO_ACTIVE_LOW>, <&portc 8 GPIO_ACTIVE_LOW>, <&portc 8 GPIO_ACTIVE_LOW>;
};

&spi2 {
	status = "okay";

	spidev@0 {
		status = "okay";
	};
};

&uart1 {
	status = "okay";
};

&uart2 {
	status = "okay";
};

&uart3 {
	status = "okay";
};

&uart4 {
	status = "okay";
};

&i2c1 {
       status = "okay";
       clock-frequency = <100000>;
};

&porta {
    pps_gpio: pps-gpio {
        compatible = "pps-gpio";
        gpios = <&porta 15 GPIO_ACTIVE_HIGH>;  // XGPIOA[15]
        assert-rising-edge;                    // 大多数 GPS 模块 PPS 上升沿有效
        status = "okay";
    };
};
